{
  "name": "meu-ponto-digital",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Portal (PWA) para digitalizar, organizar e consultar tickets de registro de ponto. Dados ficam no aparelho.",
  "scripts": {
    "ocr-assets": "node scripts/copy-ocr-assets.mjs",
    "dev": "npm run ocr-assets && vite",
    "build": "npm run ocr-assets && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ocr": "vitest run tests/ocr.node.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tesseract.js-data/por": "^1.0.0",
    "fflate": "^0.8.3",
    "idb": "^8.0.4",
    "jspdf": "^4.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jpeg-js": "^0.4.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
